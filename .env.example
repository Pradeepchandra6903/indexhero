# InboxHero model-provider configuration.
# Copy to .env and fill in only if you run with INBOXHERO_MODE=llm.
# The default (offline) path needs none of these and makes no network calls.

INBOXHERO_MODE=offline          # offline | llm
INBOXHERO_PROVIDER=none         # openai | anthropic | ollama
INBOXHERO_MODEL=none            # e.g. gpt-4o-mini, claude-3-5-sonnet, llama3.1:8b
INBOXHERO_ENDPOINT=             # e.g. http://localhost:11434 for local Ollama
INBOXHERO_API_KEY=              # secret; never commit the real .env
INBOXHERO_REQUEST_DELAY_S=4     # seconds between calls (free-tier rate limits)
INBOXHERO_MAX_RETRIES=5         # backoff attempts on HTTP 429
